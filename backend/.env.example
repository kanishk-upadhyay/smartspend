GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Postgres (use Session Pooler URL in hosted environments) and force SSL.
# Example:
# DATABASE_URL=postgresql://postgres:<URL_ENCODED_PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase project URL and service role key (used for Storage upload/delete).
SUPABASE_URL=
SUPABASE_KEY=

# Optional bucket name (defaults to "receipts")
SUPABASE_STORAGE_BUCKET=receipts

# Optional Gemini tuning
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=1.5
