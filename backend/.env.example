GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Postgres — use the Session Pooler URL (port 5432, user postgres.<project-ref>).
# Avoid the Transaction Pooler (6543): it breaks SQLAlchemy's prepared statements.
# A plain postgresql:// URL is fine — the app auto-selects the psycopg (v3) driver.
# Example:
# DATABASE_URL=postgresql://postgres.<project-ref>:<URL_ENCODED_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Supabase project URL and service role key (used for Storage upload/delete).
SUPABASE_URL=
SUPABASE_KEY=

# Optional bucket name (defaults to "receipts")
SUPABASE_STORAGE_BUCKET=receipts

# ── OCR Backends ──────────────────────────────────────────────────────────────
# Primary: Gemini 2.5 Flash — best accuracy, native PDF + schema support
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=1.5

# Fallback: Z.AI GLM-4.6V-Flash — free tier, activates when Gemini fails
# Get your key at https://z.ai
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-4.6v-flash
ZAI_MAX_RETRIES=2
ZAI_RETRY_BACKOFF_SECONDS=1.5
