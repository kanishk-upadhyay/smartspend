GEMINI_API_KEY=your_gemini_api_key_here

# Neon Postgres database URL (with sslmode=require)
# Example:
# DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Neon Object Storage (S3-compatible)
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-1
STORAGE_BUCKET=receipts

# Comma-separated list of allowed CORS origins (frontend URLs).
# Defaults to the local Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max accepted upload size in megabytes (default 15).
MAX_UPLOAD_MB=15

# Max uploads per owner per rolling 60s window (default 30).
UPLOAD_RATE_LIMIT=30

# ── OCR Backends ──────────────────────────────────────────────────────────────
# Primary: Gemini 2.5 Flash — best accuracy, native PDF + schema support
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BACKOFF_SECONDS=1.5

# Fallback: Z.AI GLM-4.6V-Flash — free tier, activates when Gemini fails
# Get your key at https://z.ai
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-4.6v-flash
ZAI_MAX_RETRIES=2
ZAI_RETRY_BACKOFF_SECONDS=1.5
