entrypoint = "backend/main.py"
modules = ["python-3.11", "nodejs-22"]

[nix]
channel = "stable-24_05"

run = "sh -c 'if [ ! -d frontend/dist ]; then (cd frontend && npm install && npm run build); fi && cd backend && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}'"

[deployment]
deploymentTarget = "autoscale"
build = ["sh", "-c", "cd frontend && npm install && npm run build && cd ../backend && pip install -r requirements.txt"]
run = ["sh", "-c", "cd backend && uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]

[[ports]]
localPort = 8000
externalPort = 80
